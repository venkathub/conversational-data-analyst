{
  "name": "conversational-data-analyst",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["shared", "backend", "frontend"],
  "scripts": {
    "seed": "npm run seed -w backend",
    "dev": "concurrently -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
